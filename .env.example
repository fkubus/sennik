# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami.
# NIGDY nie commituj .env.local ani prawdziwych kluczy do repozytorium.

# --- Adres publiczny aplikacji ---
# Używany do metadanych SEO, sitemap.xml, canonical URL, Stripe redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Project Settings -> API w panelu Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role — WYŁĄCZNIE po stronie serwera. Nigdy prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (interpretacja snów przez AI) ---
ANTHROPIC_API_KEY=
# Domyślnie tani, szybki model — patrz lib/ai/system-prompt.ts (etap 4).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Stripe ---
# Klucze testowe (sk_test_/pk_test_) w developmencie, produkcyjne dopiero na Vercel.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Endpoint Signing Secret z Stripe CLI (dev) lub Dashboard -> Webhooks (prod).
STRIPE_WEBHOOK_SECRET=
# Identyfikatory cen (Price ID) utworzonych w Stripe Dashboard — etap 5.
STRIPE_PRICE_SINGLE_INTERPRETATION=
STRIPE_PRICE_CREDIT_PACK_10=
STRIPE_PRICE_PREMIUM_SUBSCRIPTION=

# --- Szyfrowanie danych wrażliwych (dziennik snów, treść interpretacji) ---
# Klucz 32-bajtowy w base64, np. wygenerowany przez: openssl rand -base64 32
DREAM_ENCRYPTION_KEY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analityka (Plausible) ---
# Domena skonfigurowana w Plausible, np. sennik.pl
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
